# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Django
DJANGO_SECRET_KEY=change-me-to-a-real-secret
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database (used by dj-database-url)
DATABASE_URL=postgres://stockflow:stockflow@127.0.0.1:5433/stockflow

# Allowed hosts (comma-separated, for production)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost
SECURE_SSL_REDIRECT=true

# DRF throttling rates
API_USER_THROTTLE_RATE=1000/day
API_LOGIN_THROTTLE_RATE=10/minute
API_SIGNUP_THROTTLE_RATE=10/minute
LOG_LEVEL=INFO

# Copy to an untracked local file or set these in your Docker host's dashboard.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
ALLOWED_HOSTS=your-app.example.com
CSRF_TRUSTED_ORIGINS=https://your-app.example.com
SECURE_SSL_REDIRECT=true

# Optional runtime tuning and API rate limits.
PORT=8000
WEB_CONCURRENCY=2
API_USER_THROTTLE_RATE=1000/day
API_LOGIN_THROTTLE_RATE=10/minute
API_SIGNUP_THROTTLE_RATE=10/minute
LOG_LEVEL=INFO
